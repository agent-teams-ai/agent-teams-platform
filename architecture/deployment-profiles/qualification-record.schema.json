{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.ai/schemas/platform/qualification-record/v1",
  "title": "Immutable deployment profile qualification record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "profileId",
    "releaseSet",
    "environment",
    "assessments",
    "qualificationAttestation",
    "assessedAt",
    "reassessBy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordId": {
      "type": "string",
      "pattern": "^qualification-[a-z0-9][a-z0-9-]*$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "supersedesRecordId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^qualification-[a-z0-9][a-z0-9-]*$"
    },
    "releaseSet": {
      "$ref": "#/$defs/releaseSet"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assessment"
      }
    },
    "qualificationAttestation": {
      "$ref": "#/$defs/provenance"
    },
    "assessedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reassessBy": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sourceCommit",
        "buildArtifactDigest",
        "dependencyLockDigest",
        "sbomDigest",
        "provenance"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "buildArtifactDigest": {
          "$ref": "#/$defs/digest"
        },
        "dependencyLockDigest": {
          "$ref": "#/$defs/digest"
        },
        "sbomDigest": {
          "$ref": "#/$defs/digest"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "attestationRef",
        "contentDigest"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "attestationRef": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "contractArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "contentDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "releaseSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productAuthority",
        "orchestrator",
        "agentRuntime",
        "contracts",
        "qualificationCriteria",
        "topologyPolicyDigest"
      ],
      "properties": {
        "productAuthority": {
          "$ref": "#/$defs/productAuthorityArtifact"
        },
        "orchestrator": {
          "$ref": "#/$defs/artifact"
        },
        "agentRuntime": {
          "$ref": "#/$defs/artifact"
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contractArtifact"
          }
        },
        "qualificationCriteria": {
          "$ref": "#/$defs/contractArtifact"
        },
        "topologyPolicyDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "productAuthorityArtifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "artifact"],
          "properties": {
            "kind": { "const": "PLATFORM" },
            "artifact": { "$ref": "#/$defs/artifact" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "artifact"],
          "properties": {
            "kind": { "const": "STANDALONE_AUTHORITY" },
            "artifact": { "$ref": "#/$defs/artifact" }
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "deploymentTopology",
        "configurationPolicyDigest"
      ],
      "properties": {
        "os": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "architecture": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "deploymentTopology": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "configurationPolicyDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "artifactRef",
        "contentDigest"
      ],
      "properties": {
        "producer": {
          "enum": [
            "PLATFORM",
            "ORCHESTRATOR",
            "AGENT_RUNTIME",
            "QUALIFICATION_PIPELINE"
          ]
        },
        "artifactRef": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "outcome",
        "evidence",
        "verifiedClaims"
      ],
      "properties": {
        "gateId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "verifiedClaims": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    }
  }
}
