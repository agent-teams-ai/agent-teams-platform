{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.ai/schemas/platform/node-compatibility.schema.json",
  "title": "Platform Node runtime compatibility record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "migration",
    "platform",
    "qualification",
    "nodeApis",
    "upstreamDependencies",
    "publishedArtifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "platform.node-runtime-compatibility/v1" },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionDefault", "node25Policy", "cutover"],
      "properties": {
        "productionDefault": {
          "const": "Node 24 remains production/default until Node 26 officially enters LTS and the owner authorizes cutover."
        },
        "node25Policy": { "const": "SKIPPED" },
        "cutover": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "requiresOfficialLts", "requiresOwnerAuthorization"],
          "properties": {
            "status": { "const": "NOT_AUTHORIZED" },
            "requiresOfficialLts": { "const": true },
            "requiresOwnerAuthorization": { "const": true }
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "productionVersion", "candidateVersion", "skippedVersion"],
      "properties": {
        "engine": { "type": "string" },
        "productionVersion": { "type": "string" },
        "candidateVersion": { "type": "string" },
        "skippedVersion": { "type": "string" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetVersion", "status", "strictInstall", "apiAudit", "focusedCi"],
      "properties": {
        "targetVersion": { "type": "string" },
        "status": {
          "enum": [
            "IMPLEMENTED_PENDING_QUALIFICATION",
            "PENDING_UPSTREAM_ENGINE_COMPATIBILITY",
            "QUALIFIED"
          ]
        },
        "strictInstall": {
          "enum": [
            "IMPLEMENTED_PENDING_UPSTREAM",
            "BLOCKED_BY_UPSTREAM_ENGINE",
            "QUALIFIED"
          ]
        },
        "apiAudit": { "const": "IMPLEMENTED" },
        "focusedCi": { "const": "IMPLEMENTED" }
      }
    },
    "nodeApis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^node:" }
    },
    "upstreamDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foundation", "runtime"],
      "properties": {
        "foundation": {
          "type": "array",
          "items": { "$ref": "#/$defs/upstreamDependency" }
        },
        "runtime": {
          "type": "array",
          "items": { "$ref": "#/$defs/upstreamDependency" }
        }
      }
    },
    "publishedArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "runtimeDependencies"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "runtimeDependencies": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "upstreamDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "relationship",
        "nodeEngine",
        "node26StrictInstall"
      ],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "relationship": {
          "enum": ["DIRECT", "TRANSITIVE", "OPAQUE_EXTERNAL"]
        },
        "nodeEngine": { "type": "string" },
        "node26StrictInstall": {
          "enum": ["SUPPORTED", "BLOCKED_BY_UPSTREAM_ENGINE"]
        }
      }
    }
  }
}
