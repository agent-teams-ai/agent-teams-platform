{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-teams:platform:project-management:managed-scope-admission-process:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "authority",
    "limits",
    "axes",
    "events"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "platform.project-management.managed-scope-admission" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalStorage", "xstateSnapshot", "externalWireContract"],
      "properties": {
        "canonicalStorage": { "const": "persisted-domain-aggregate" },
        "xstateSnapshot": { "const": "test-model-only" },
        "externalWireContract": { "const": false }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "generations"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 1 },
        "generations": { "type": "integer", "minimum": 1 }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "authority", "reconciliation", "generation"],
      "properties": {
        "lifecycle": { "$ref": "#/$defs/axis" },
        "authority": { "$ref": "#/$defs/axis" },
        "reconciliation": { "$ref": "#/$defs/axis" },
        "generation": { "$ref": "#/$defs/axis" }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial", "states"],
      "properties": {
        "initial": { "type": "string", "minLength": 1 },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from", "to", "operation"],
      "properties": {
        "type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "from": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "to": { "type": "string", "minLength": 1 },
        "operation": {
          "enum": [
            "claim",
            "authorize-dispatch",
            "deny-dispatch",
            "release-retry",
            "release-exhausted",
            "lose-acknowledgement",
            "reconcile-not-accepted",
            "observe-admitted",
            "observe-rejected",
            "observe-stale",
            "observe-conflict",
            "finalize-ready",
            "deny-after-receipt",
            "cancel",
            "complete-cancellation",
            "resume",
            "ignore-stale-generation",
            "ignore-stale-revision"
          ]
        },
        "variant": { "type": "string", "minLength": 1 },
        "guard": {
          "enum": [
            "attempt-available",
            "attempt-exhausted",
            "successor-generation-available",
            "retained-admitted-receipt"
          ]
        }
      }
    }
  }
}
