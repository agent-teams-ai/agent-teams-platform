{
  "name": "@agent-teams/platform-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Private SaaS control plane for Agent Teams.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.18.0 <12"
  },
  "scripts": {
    "architecture:check": "node scripts/architecture/validate-deployment-profiles.mjs && node scripts/architecture/validate-managed-installation-policy.mjs && node scripts/architecture/validate-managed-scope-admission-spec.mjs && node scripts/architecture/validate-reviewrouter-codex-workflow.mjs && node scripts/architecture/validate-reviewrouter-interaction-workflow.mjs && pnpm architecture:review",
    "architecture:domain": "node scripts/architecture/validate-platform-domain.mjs",
    "architecture:immutability": "node scripts/architecture/validate-qualification-record-history.mjs",
    "architecture:review": "node scripts/architecture/validate-deployment-profiles.mjs --references-only && node scripts/architecture/validate-platform-orchestrator-review.mjs && pnpm architecture:domain",
    "architecture:test": "node --test --test-concurrency=1 scripts/architecture/*.test.mjs",
    "check": "pnpm foundation:check && pnpm docs:protocol:check && pnpm architecture:check && pnpm architecture:immutability && pnpm architecture:test && pnpm lint && pnpm typecheck && pnpm packages:check",
    "check:changed": "agent-teams-foundation agent-workflow changed --consumer .",
    "check:fast": "pnpm foundation:check && pnpm docs:protocol:check && pnpm architecture:check && pnpm architecture:immutability && pnpm architecture:test && pnpm lint && pnpm typecheck && pnpm packages:check:fast",
    "docs:check": "agent-teams-docs check --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:doctor": "agent-teams-docs doctor --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:find": "agent-teams-docs find --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:info": "agent-teams-docs info --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:new": "agent-teams-docs new --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:protocol:check": "pnpm docs:check && pnpm docs:semantic && pnpm docs:validators && pnpm docs:qualification",
    "docs:qualification": "agent-teams-docs qualify --consumer . && node --test scripts/docs/docs-protocol-adoption.test.mjs",
    "docs:recover": "agent-teams-docs recover --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:semantic": "markdownlint-cli2 README.md AGENTS.md 'docs/**/*.md'",
    "docs:validate:platform-architecture": "node scripts/architecture/validate-deployment-profiles.mjs --references-only && node scripts/architecture/validate-platform-orchestrator-review.mjs",
    "docs:validate:domain-materialization": "node scripts/architecture/validate-platform-domain.mjs",
    "docs:validators": "pnpm docs:validate:platform-architecture && pnpm docs:validate:domain-materialization",
    "foundation:assert-dev-only": "agent-teams-foundation assert-dev-only",
    "foundation:assert-registry": "agent-teams-foundation assert-registry",
    "foundation:attach": "agent-teams-foundation attach",
    "foundation:check": "agent-teams-foundation check && pnpm foundation:assert-dev-only && pnpm foundation:assert-registry",
    "foundation:detach": "agent-teams-foundation detach",
    "foundation:status": "agent-teams-foundation status",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings --disable-nested-config .",
    "lint:files": "oxlint --config .oxlintrc.json --deny-warnings --disable-nested-config --format agent --no-error-on-unmatched-pattern",
    "packages:check": "pnpm packages:check:fast && pnpm spec:clean-checkout",
    "packages:check:fast": "pnpm --filter './packages/**' run check && pnpm spec:property && pnpm spec:mutation && pnpm spec:model && pnpm spec:production-conformance",
    "scaffold:apply": "agent-teams-foundation scaffold-apply",
    "scaffold:plan": "agent-teams-foundation scaffold-plan",
    "scaffold:recover": "agent-teams-foundation scaffold-recover",
    "spec:model": "pnpm --filter @agent-teams/platform-executable-specifications spec:model",
    "spec:mutation": "pnpm --filter @agent-teams/platform-executable-specifications spec:mutation",
    "spec:production-conformance": "pnpm --filter @agent-teams/platform-executable-specifications spec:production-conformance",
    "spec:property": "pnpm --filter @agent-teams/platform-executable-specifications spec:property",
    "spec:clean-checkout": "node tooling/executable-specifications/scripts/verify-clean-spec-gates.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@agent-teams/docs-protocol": "0.2.0",
    "@agent-teams/engineering-foundation": "0.20.0",
    "@ast-grep/napi": "catalog:",
    "@types/node": "catalog:",
    "@xstate/graph": "catalog:",
    "ajv": "catalog:",
    "fast-check": "catalog:",
    "markdownlint-cli2": "catalog:",
    "mdast-util-to-string": "catalog:",
    "oxlint": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-parse": "catalog:",
    "typescript": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "xstate": "catalog:",
    "yaml": "catalog:"
  }
}
